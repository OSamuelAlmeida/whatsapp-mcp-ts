{
  "name": "whatsapp-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "WhatsApp MCP server (Baileys / WhatsApp Web), single-process stdio, per-account isolation. Forked from jlucaso/whatsapp-mcp-ts.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "baileys": "7.0.0-rc13",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": ["baileys", "protobufjs"]
  }
}
