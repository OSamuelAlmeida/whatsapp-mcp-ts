# baileys & protobufjs ship prebuilt; we intentionally do NOT run their install
# scripts (see pnpm.ignoredBuiltDependencies in package.json). Skip pnpm's
# pre-run dependency verification so `pnpm build` / `pnpm start` don't re-trigger
# the build-approval gate on every invocation. No build scripts are run.
verify-deps-before-run=false
